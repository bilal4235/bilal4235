{
  "expo": {
    "name": "Bir Ayet Bir Yorum",
    "slug": "bir-ayet-bir-yorum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "birayetbiryorum",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Her gün bir Kuran ayeti ve tefsiri - Diyanet İşleri Başkanlığı resmi kaynağı",
    "primaryColor": "#2C5F2D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.birayetbiryorum.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Günlük ayet bildirimleri almak için izin gereklidir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2C5F2D"
      },
      "package": "com.birayetbiryorum.app",
      "versionCode": 1,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2C5F2D"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2C5F2D",
          "sounds": ["./assets/notification.wav"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
